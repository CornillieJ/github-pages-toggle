{
  "manifest_version": 2,
  "name": "GitHub Pages Toggle",
  "version": "1.2.0",
  "description": "Jump between a GitHub repo and its GitHub Pages site with a configurable keyboard shortcut or the toolbar popup.",
  "author": "Jeffrey Cornillie",
  "homepage_url": "https://github.com/CornillieJ/github-pages-toggle",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "tabs",
    "storage"
  ],
  "background": {
    "scripts": ["url-mapper.js", "badge.js", "background.js"],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": ["*://github.com/*", "*://*.github.io/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_title": "Toggle GitHub Pages",
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "github-pages-toggle@cornilliej.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
