{
  "manifest_version": 2,
  "name": "RepoTools",
  "version": "2.4.2",
  "description": "A GitHub repo toolbelt: toggle to its Pages site, copy clone URLs, jump to Issues/PRs/Actions/Releases, and open it in DeepWiki or GitDiagram.",
  "author": "Jeffrey Cornillie",
  "homepage_url": "https://github.com/CornillieJ/repotools",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "clipboardWrite"
  ],
  "background": {
    "scripts": ["url-mapper.js", "badge.js", "background.js"],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": ["*://github.com/*", "*://*.github.io/*"],
      "js": ["url-mapper.js", "shortcuts.js", "page-badges.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_title": "RepoTools",
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "github-pages-toggle@cornilliej.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
